# Server
HOST=0.0.0.0
PORT=1337

# Secrets — gerar valores novos em produção (nunca reaproveitar os do .env local).
# Gerar com: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — dev local usa sqlite (default, ver config/database.ts). Em produção
# (Railway), trocar para:
# DATABASE_CLIENT=postgres
# DATABASE_URL=<connection string fornecida pelo Railway>
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Upload de logomarca — Cloudflare R2 (S3-compatible, ver config/plugins.ts).
# Sem essas variáveis, o Strapi usa o provider padrão (disco local) — ok para
# dev, não para produção (Railway não persiste arquivos locais entre deploys).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=inprint-uploads
