{
  "kind": "collectionType",
  "collectionName": "kits",
  "info": {
    "singularName": "kit",
    "pluralName": "kits",
    "displayName": "Kit especial",
    "description": "Kit temático com produtos combinados"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "descricao": {
      "type": "text"
    },
    "produtos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::produto.produto",
      "inversedBy": "kits"
    }
  }
}
