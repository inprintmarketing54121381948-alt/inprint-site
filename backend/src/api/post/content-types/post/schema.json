{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post do blog",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "resumo": {
      "type": "text"
    },
    "conteudo": {
      "type": "richtext"
    },
    "imagemCapa": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "publicadoEm": {
      "type": "date"
    }
  }
}
