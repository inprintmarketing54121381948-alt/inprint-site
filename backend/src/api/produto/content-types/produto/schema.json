{
  "kind": "collectionType",
  "collectionName": "produtos",
  "info": {
    "singularName": "produto",
    "pluralName": "produtos",
    "displayName": "Produto",
    "description": "Produto do catálogo — ver planejamento-inprint.md, seção 4.3"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "codigo": {
      "type": "string",
      "required": true
    },
    "descricao": {
      "type": "text"
    },
    "quantidadeMinima": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "material": {
      "type": "string"
    },
    "cores": {
      "type": "json",
      "description": "Lista de cores disponíveis, ex: [\"Azul\", \"Branco\"]"
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "galeria": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "produtos"
    },
    "kits": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::kit.kit",
      "mappedBy": "produtos"
    },
    "ocasioes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ocasiao.ocasiao",
      "mappedBy": "produtosSugeridos"
    }
  }
}
